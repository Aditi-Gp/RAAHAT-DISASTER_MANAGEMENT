{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",                        /* Changed from nodenext for bundler support */
    "moduleResolution": "bundler",             /* Added so TS looks into node_modules properly */
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,                            /* Added: Lets Vite/bundler handle JS emission */
    
    // Your preferred settings kept intact
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force"
  }
}
